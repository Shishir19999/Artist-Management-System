generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?  @map("email_verified")
  password      String?
  image         String?
  gender        Gender     @default(MALE)
  phone         String?
  address       String?
  birthDate     DateTime?  @map("birth_date") @db.Date
  role          Role       @default(USER)
  tokenVersion  Int        @default(0) @map("token_version")
  accounts      Account[]
  sessions      Session[]
  artist        Artist[]   @relation("ArtistCreator") // artists this user created
  artistProfile Artist?    @relation("ArtistProfile") // the artist record of a user with role ARTIST
  playlists     Playlist[]
  favorites     Favorite[]

  @@map("users")
}

model Artist {
  id                 String   @id @default(cuid())
  name               String
  email              String?  @unique
  password           String?
  gender             Gender   @default(MALE)
  first_release_year String?
  total_albums       Int?
  address            String?
  bio                String?  @db.Text
  photo              String?  @db.MediumText
  website            String?
  instagram          String?
  youtube            String?
  spotify            String?
  createdBy          String?
  userId             String?  @unique
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  user    User?   @relation("ArtistCreator", fields: [createdBy], references: [id])
  account User?   @relation("ArtistProfile", fields: [userId], references: [id], onDelete: SetNull)
  music   Music[]
  gigs    Gig[]
}

model Music {
  id          String    @id @default(cuid())
  title       String
  album       String?
  genre       Genre     @default(CLASSIC)
  artistId    String?
  durationSec Int?
  releaseDate DateTime? @db.Date
  coverUrl    String?   @db.MediumText
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  artist        Artist?        @relation(fields: [artistId], references: [id]) // Relation to Artist
  playlistItems PlaylistItem[]
}

model Playlist {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  ownerId     String   @map("owner_id")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  owner User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items PlaylistItem[]

  @@index([ownerId])
  @@map("playlists")
}

model PlaylistItem {
  id         String @id @default(cuid())
  playlistId String @map("playlist_id")
  musicId    String @map("music_id")
  position   Int

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  music    Music    @relation(fields: [musicId], references: [id], onDelete: Cascade)

  @@unique([playlistId, musicId])
  @@index([playlistId, position])
  @@map("playlist_items")
}

model Favorite {
  id         String         @id @default(cuid())
  userId     String         @map("user_id")
  targetType FavoriteTarget @map("target_type")
  targetId   String         @map("target_id")
  created_at DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("favorites")
}

model Gig {
  id         String    @id @default(cuid())
  artistId   String    @map("artist_id")
  title      String
  venue      String
  city       String?
  date       DateTime
  status     GigStatus @default(CONFIRMED)
  fee        Int?
  notes      String?   @db.Text
  createdBy  String?   @map("created_by")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
  @@index([date])
  @@map("gigs")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  userName   String?  @map("user_name")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  summary    String   @db.VarChar(255)
  created_at DateTime @default(now())

  @@index([userId, created_at])
  @@index([created_at])
  @@map("activity_logs")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum Genre {
  RNB
  COUNTRY
  CLASSIC
  ROCK
  JAZZ
  POP
  HIPHOP
  ELECTRONIC
  FOLK
  BLUES
}

enum FavoriteTarget {
  ARTIST
  SONG
}

enum GigStatus {
  HOLD
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Role {
  USER
  ARTIST
  ARTIST_MANAGER
}
