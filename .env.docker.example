# Copy to .env next to docker-compose.yml (never commit the real file).
# DB_PASSWORD is placed inside a URL: use only URL-safe characters (letters, digits, - _ . ~)
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password
# generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
# public URL users type in the browser (must match the Google redirect URI host)
NEXTAUTH_URL=http://localhost:3000
APP_PORT=3000
# optional - leave empty to hide the "Continue with Google" button
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
