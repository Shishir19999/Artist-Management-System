DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/artist_db"
# generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Google sign-in (optional). Leave both empty to hide the "Continue with Google" button.
# Create them in Google Cloud Console - see docs/GOOGLE_OAUTH.md
# e.g. GOOGLE_CLIENT_ID="1234567890-abc.apps.googleusercontent.com"  /  GOOGLE_CLIENT_SECRET="GOCSPX-..."
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Used only by `npx prisma db seed` to create the first Artist Manager (the top role)
SEED_MANAGER_EMAIL="manager@example.com"
SEED_MANAGER_PASSWORD="change-me-please"
# Optional demo accounts (manager@, aurora@, dusty@, neon@, user@, listener@artist.local) + sample data, all with this password
# SEED_DEMO_PASSWORD="change-me-too"
